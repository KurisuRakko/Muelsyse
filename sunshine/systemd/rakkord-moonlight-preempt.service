[Unit]
Description=Selkies web client preempts the Moonlight session
ConditionUser=@USER@
# 只做顺序，不用 Requires/BindsTo：这个监听挂掉不能影响 Selkies 或 Sunshine。
After=remote-desktop-selkies.service
Wants=remote-desktop-selkies.service

[Service]
Type=simple
ExecStart=%h/.local/libexec/rakkord-moonlight-preempt
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
