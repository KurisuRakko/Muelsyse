# Muelsyse 主机参数。复制为 ~/.config/muelsyse/env（chmod 600 可选；不放密码），按本机改。
# 不提交真实值：仓库里只有这个样例。
#
# 两处读它：
#   1. scripts/deploy-host.sh / scripts/check-drift.py 在安装、比较 kind=render 与 kind=check
#      的文件前，把文件里的 @MUELSYSE_*@ 换成这里的值（另有 @HOME@ @USER@ @GROUP@ @UID@ 取
#      当前用户）。没写的变量用下面注释里的默认值；网卡地址类没有默认，用到又没写就报错。
#   2. 仓库里的构建、POC 脚本经 scripts/muelsyse-env.sh 读它（不存在就跳过；环境里已经给了的
#      变量优先），再用 ${MUELSYSE_X:-默认}。
#
# 格式只认最简单的 KEY=VALUE：一行一条、# 注释、值两端成对引号会去掉、不做 $ 展开，
# Python 与 bash 两边解析得到同一个值。改完跑 scripts/deploy-host.sh 看展开后的差异。
# 注意展开只看这个文件，不看当前 shell 的环境变量，免得定时漂移检查和手工部署结果不一样。

# ---- 网络（socat 局域网入口、nftables 片段、Sunshine csrf 来源）----
# Selkies 对外端口：selkies 监听 127.0.0.1:<端口>，socat 在 LAN 地址的同一端口转发进来
#MUELSYSE_PORT=8090
# socat 绑定的局域网地址，与 nftables 放行的来源网段
MUELSYSE_LAN_BIND=192.0.2.10
MUELSYSE_LAN_CIDR=192.0.2.0/24
# 本机的 Tailscale 地址（tailscale ip -4）；只出现在说明和 Sunshine csrf 来源里
MUELSYSE_TAILNET_BIND=198.51.100.1

# 对外的公网域名（反代/隧道指到 127.0.0.1:<端口>）；只出现在说明文字里
MUELSYSE_PUBLIC_HOST=desktop.example.com

# ---- Selkies ----
# Selkies 依赖所在的 venv（unit 的 PYTHONPATH 取 <venv>/lib/python3.13/site-packages）
#MUELSYSE_SELKIES_VENV=/opt/selkies
# pixelflux 在 DRINODE 为空时兜底选卡：intel | nvidia
#MUELSYSE_AUTO_GPU=intel

# 主数据 WebSocket 的直连线路（默认都空 = 关闭）。DIRECT_WS_URLS 是逗号分隔的 https 基址，
# 指向同一个 Selkies 但绕开公网入口（如 tailscale serve 的 TLS 端口）；客户端测 RTT 择优。
# 直连时 WebSocket 跨站，ALLOWED_ORIGINS 要写上页面的 origin（https://<公网域名>）。
#MUELSYSE_ALLOWED_ORIGINS=https://desktop.example.com
#MUELSYSE_DIRECT_WS_URLS=https://host.example.ts.net:8444/

# ---- Sunshine ----
# sunshine.conf 模板里 adapter_name 用的 render node（docker-compose 也读同名环境变量）
#MUELSYSE_DRI_NODE=/dev/dri/renderD128
# apps.json 串流时切分辨率的显示器输出名（xrandr 里看）、串流分辨率、结束后恢复的分辨率
#MUELSYSE_SUNSHINE_OUTPUT=HDMI-1
#MUELSYSE_SUNSHINE_MODE=1920x1080
#MUELSYSE_SUNSHINE_RESTORE_MODE=1920x1200

# ---- 构建与 POC 脚本（只在 scripts/ 里用，不参与展开）----
# 前端构建用的 node 所在目录；默认 ~/.local/node-v24.21.0-linux-x64/bin，不存在时退回 PATH 里的 node
#MUELSYSE_NODE_BIN=/home/you/.local/node-v24.21.0-linux-x64/bin
# KWin 构建树（默认 ~/build/muelsyse-kwin）
#MUELSYSE_KWIN_BUILD_DIR=/home/you/build/muelsyse-kwin
# POC 脚本里虚拟输出的分辨率（默认 3840x2160）
#MUELSYSE_RESOLUTION=3840x2160
# 注意：MUELSYSE_RUNTIME_ROOT 在 build-kwin.sh 和 build-release.sh 里指不同目录，别写在这里，
# 要改就在命令行上单独给。
