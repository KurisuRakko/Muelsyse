[Unit]
Description=KDE Plasma Wayland virtual host session for Selkies
ConditionUser=@USER@
# 预检未批准前没有这个标记，服务即使被误 enable 也不会启动。
ConditionPathExists=%h/.config/selkies/remote-desktop.production-enabled
After=pipewire.service wireplumber.service
Before=remote-desktop-selkies.service

[Service]
Type=simple
Environment=HOME=%h
Environment=USER=@USER@
Environment=LOGNAME=@USER@
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=XDG_SESSION_DESKTOP=KDE
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_MENU_PREFIX=plasma-
Environment=QT_QPA_PLATFORM=wayland
Environment=DESKTOP_SESSION=plasmawayland
Environment=KDE_FULL_SESSION=true
# kded6 用 KDE_FULL_SESSION + KDE_SESSION_VERSION(==6) + KDE_SESSION_UID 三个变量
# 判断"当前是不是 KDE 会话"，只有判据成立才自动加载 X-KDE-Kded-phase=1/2 的模块
# （含 statusnotifierwatcher，它提供 /StatusNotifierWatcher，缺了就没有系统托盘图标）。
# 与 startplasma（plasma-workspace/startkde/startplasma.cpp）发布的值保持一致。
Environment=KDE_SESSION_VERSION=6
Environment=KDE_SESSION_UID=@UID@
# 光标主题用 KDE 默认的 breeze_cursors：先前的浅色变体与 KDE 默认的 Breeze 观感不一致，
# 桌面和设置里看起来就不是同一套主题。这里必须改，因为 systemd 发布的 XCURSOR_THEME
# 优先级高于 kcminputrc，只改 KDE 配置文件不会生效。
Environment=XCURSOR_THEME=breeze_cursors
Environment=XCURSOR_SIZE=24
Environment=WAYLAND_DISPLAY=wayland-remote-desktop
# KWin 跑 scripts/build-kwin.sh 装出来的版本化 prefix（current 软链），不再直接从构建树跑：
# 旧的 ~/build/kwin-adapter 源码是 POC 树，一重编就会盖掉双光标修复（docs/host-files-inventory.md）。
Environment=SELKIES_KWIN_PREFIX=%h/.local/share/remote-desktop/kwin/current
# kwin_wayland 和插件的 DT_RUNPATH 指向构建树（~/build/rakkord-kwin/bin），构建树随时可能
# 被重编或清掉。glibc 的搜索顺序里 LD_LIBRARY_PATH
# 先于 DT_RUNPATH，所以这一行让 prefix 自己的 bin/ 成为 libkwin 的唯一来源，
# 换 prefix 时也不会再去别处取库。
Environment=LD_LIBRARY_PATH=%h/.local/share/remote-desktop/kwin/current/bin
Environment=SELKIES_KWIN_ADAPTER_SOCKET=%t/selkies-kwin-adapter.sock
Environment=KWIN_SCREENCAST_STATS=1
# 选卡说明（2026-09-25 任务 007 修订）：KWin 的 --virtual 后端由
# VirtualBackend::findRenderDevice()（kwin/src/backends/virtual/virtual_backend.cpp:25-57）
# 决定用哪块卡 —— 它遍历 libdrm 的 drmGetDevices2() 结果，取**第一个能打开**的 render 节点，
# 而 drmGetDevices2() 用的是 readdir("/dev/dri") 的顺序（libdrm xf86drm.c，不是 udev 的
# syspath 顺序）。**KWIN_DRM_DEVICES 在 --virtual 下无效**：只有 KMS 后端的 DrmBackend
# 读它（kwin/src/backends/drm/drm_backend.cpp:75）；main_wayland.cpp 的 --drm 也只是
# 切成 KMS 后端的布尔开关，不能指定设备路径。
# 所以两种模式都靠"让候选里只剩一张卡"来钉住 KWin，由 sudo rakko-gpu-mode 写
# /etc/modprobe.d/00-rakko-gpu-mode.conf 实现：
#   intel 模式（方案 A）：install nvidia-drm /bin/true -> NVIDIA 没有 DRM 节点 -> KWin 只能选 Intel；
#   nvidia 模式：install i915 /bin/true + nvidia-drm modeset=1 -> 只剩 P620 -> KWin 在 NVIDIA 渲染，
#                Selkies 跟随同卡零拷贝 NVENC（见 scripts/selkies-dri-exec.sh）。
# 验收脚本会按 dri_mode() 核对 KWin 打开的节点（scripts/verify-nvenc.sh §4）：
# intel 模式断言"nvidia_drm 未加载 + NVIDIA 无任何 DRM 节点"，nvidia 模式断言相反。
# 这两条一旦破，KWin 就可能选错卡，Selkies 随之跨卡丢帧黑屏（tasks/gpu-nvenc/004.report.md §1）。
# 必须走 launcher：若把 ExecStart 直接指向 Debian 装机自带的系统 kwin_wayland，
# 它不加载 selkieskwinadapter.so 插件，抓屏链路会断；launcher 依据 SELKIES_KWIN_PREFIX
# 改选隔离构建的 kwin_wayland 并补上 bin/kwin/plugins 的 QT_PLUGIN_PATH。
ExecStart=%h/.local/libexec/selkies-wayland-session
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
